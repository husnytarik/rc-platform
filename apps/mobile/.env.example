# cp .env.example .env — Render'a deploy edilen API'nin genel URL'i
EXPO_PUBLIC_API_URL=https://rc-api.onrender.com

# Google Cloud Console → Credentials'ta oluşturulan client'lar
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# iOS client'ın "reversed client ID"si (com.googleusercontent.apps.XXXX)
GOOGLE_IOS_URL_SCHEME=
