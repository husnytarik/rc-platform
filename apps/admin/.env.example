# Admin panel — yerel geliştirme
# API kök adresi (tRPC yüzeyi burada /trpc altında)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Google Cloud Console → Credentials → "Web application" client (admin panel
# origin'i Authorized JavaScript origins'e eklenmeli). Backend'deki
# GOOGLE_ADMIN_CLIENT_ID ile AYNI değer olmalı — id_token audience eşleşmesi için.
NEXT_PUBLIC_GOOGLE_ADMIN_CLIENT_ID=
