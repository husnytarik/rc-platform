# ─────────────────────────────────────────────────────────────
# rc-platform · ortam değişkenleri örneği
# Kopyala:  cp .env.example .env   (kök dizinde; .env asla commit edilmez)
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
API_PORT=3001
API_URL=http://localhost:3001
ADMIN_URL=http://localhost:3000

# ── Veritabanı (Neon) ────────────────────────────────────────
# Neon panelinden "Connection string" (pooled) — sonuna ?sslmode=require ekli olmalı
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/rc?sslmode=require
# Prisma migrate/introspect için pooling'siz (direct) bağlantı
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/rc?sslmode=require

# ── Kimlik / JWT ─────────────────────────────────────────────
# openssl rand -base64 48  ile üret
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=75

# ── OTP / SMS (Netgsm) ───────────────────────────────────────
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_RATE_LIMIT_PER_HOUR=5
# development'ta true iken SMS gönderilmez, kod API loglarına yazılır
OTP_DEV_ECHO=true
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_SENDER=

# ── Dosya depolama (Cloudflare R2, S3 uyumlu) ────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=rc-media
R2_PUBLIC_URL=

# ── Gözlem ───────────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=debug

# ── Push (Expo) ──────────────────────────────────────────────
EXPO_ACCESS_TOKEN=
