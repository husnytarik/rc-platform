# ─────────────────────────────────────────────────────────────
# rc-platform · ortam değişkenleri örneği
# Kopyala:  cp .env.example .env   (kök dizinde; .env asla commit edilmez)
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
API_PORT=3001
API_URL=http://localhost:3001
ADMIN_URL=http://localhost:3000

# ── Veritabanı (Neon) ────────────────────────────────────────
# Neon panelinden "Connection string" (pooled) — sonuna ?sslmode=require ekli olmalı
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/rc?sslmode=require
# Prisma migrate/introspect için pooling'siz (direct) bağlantı
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/rc?sslmode=require

# ── Kimlik / JWT ─────────────────────────────────────────────
# openssl rand -base64 48  ile üret
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=75

# ── Kimlik / SMS ile giriş (T.C. kimlik + telefon + SMS kodu) ──
# Netgsm hesabı (ön ödemeli kontör) — üçü birlikte; boşsa geliştirmede kod log'a yazılır, üretimde gönderim reddedilir
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_HEADER=
# İlk yönetici telefon(lar)ı, virgülle (+905xxxxxxxxx)
ADMIN_PHONES=
# SMS sağlayıcısı yokken geçici mod: true → müşteri kodu uygulamaya döner; yönetici ADMIN_PASSWORD ile girer
SMS_MOCK=
ADMIN_PASSWORD=
# TC özet anahtarı (>=16 karakter, opsiyonel; boşsa JWT_REFRESH_SECRET). Sonradan değiştirmeyin.
TC_HASH_SECRET=
OTP_DAILY_CAP=200

# ── Dosya depolama (Cloudflare R2, S3 uyumlu) ────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=rc-media
R2_PUBLIC_URL=

# ── Gözlem ───────────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=debug

# ── Push (Expo) ──────────────────────────────────────────────
EXPO_ACCESS_TOKEN=
